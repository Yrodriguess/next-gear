rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource != null
             && request.resource.size < 8 * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }

    function isValidPdf() {
      return request.resource != null
             && request.resource.size < 10 * 1024 * 1024
             && request.resource.contentType == 'application/pdf';
    }

    // ─────────────────────────────────────────────────────────
    // DOCUMENTOS ASSINADOS / TERMOS PDF
    // ─────────────────────────────────────────────────────────
    match /documentos/{orgId}/{arquivo} {
      allow read: if true;

      allow create: if isSignedIn()
                    && isValidPdf();

      // Documento gerado não pode ser alterado ou apagado.
      allow update, delete: if false;
    }


    // ─────────────────────────────────────────────────────────
    // PADRÃO NOVO DE FOTOS
    //
    // organizations/{orgId}/{tipo}/{entidadeId}/{arquivo}
    //
    // Exemplos:
    // organizations/next-gear/products/ABC/foto.jpg
    // organizations/next-gear/clientes/XYZ/fachada.jpg
    // organizations/next-gear/expositores/EXP001/foto.jpg
    // ─────────────────────────────────────────────────────────
    match /organizations/{orgId}/{tipo}/{entidadeId}/{arquivo} {
      allow read: if true;

      allow create, update: if isSignedIn()
                            && isValidImage();

      allow delete: if isSignedIn();
    }


    // ─────────────────────────────────────────────────────────
    // CLIENTES - CAMINHO ATUAL DO APP
    //
    // Hoje o Flutter está gravando:
    // clientes/{orgId}/{clienteId}/{arquivo}
    //
    // Mantemos essa regra para não quebrar o cadastro atual.
    // ─────────────────────────────────────────────────────────
    match /clientes/{orgId}/{clienteId}/{arquivo} {
      allow read: if true;

      allow create, update: if isSignedIn()
                            && isValidImage();

      allow delete: if isSignedIn();
    }


    // ─────────────────────────────────────────────────────────
    // BLOQUEIO PADRÃO
    // ─────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}