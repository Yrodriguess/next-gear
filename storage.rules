rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource != null
             && request.resource.size < 8 * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }

    function isValidPdf() {
      return request.resource != null
             && request.resource.size < 10 * 1024 * 1024
             && request.resource.contentType == 'application/pdf';
    }

    // ─────────────────────────────────────────────────────────
    // MEMBRO ATIVO DA EQUIPE
    //
    // Mesma regra do firestore.rules: estar logado não basta.
    // Enviar, apagar ou ler um arquivo pelo caminho exige cadastro
    // em "usuarios" no Firestore, ativo e com papel da equipe.
    // ─────────────────────────────────────────────────────────
    function meuUsuario() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }

    function ehMembroAtivo() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && meuUsuario().get('ativo', true) == true
        && meuUsuario().get('role', '') in ['admin', 'financeiro', 'vendedor', 'estoque'];
    }

    // ─────────────────────────────────────────────────────────
    // LEITURA: "read" é a soma de duas permissões.
    //
    // get  = ler UM arquivo pelo caminho exato. O app usa isso para
    //        pegar o link da foto ou do PDF logo depois de enviar,
    //        então basta liberar para a equipe ativa.
    // list = listar a pasta inteira. Fica bloqueado: o app não usa.
    //
    // O link que o lojista recebe pelo WhatsApp e os links das fotos
    // têm um token próprio e abrem o arquivo sem passar por estas
    // regras. Por isso continuam funcionando sem login.
    // ─────────────────────────────────────────────────────────


    // ─────────────────────────────────────────────────────────
    // DOCUMENTOS ASSINADOS / TERMOS PDF
    // ─────────────────────────────────────────────────────────
    match /documentos/{orgId}/{arquivo} {
      allow get: if ehMembroAtivo();
      allow list: if false;

      allow create: if ehMembroAtivo()
                    && isValidPdf();

      // Documento gerado não pode ser alterado ou apagado.
      allow update, delete: if false;
    }


    // ─────────────────────────────────────────────────────────
    // PADRÃO NOVO DE FOTOS
    //
    // organizations/{orgId}/{tipo}/{entidadeId}/{arquivo}
    //
    // Exemplos:
    // organizations/next-gear/products/ABC/foto.jpg
    // organizations/next-gear/clientes/XYZ/fachada.jpg
    // organizations/next-gear/expositores/EXP001/foto.jpg
    // ─────────────────────────────────────────────────────────
    match /organizations/{orgId}/{tipo}/{entidadeId}/{arquivo} {
      allow get: if ehMembroAtivo();
      allow list: if false;

      allow create, update: if ehMembroAtivo()
                            && isValidImage();

      allow delete: if ehMembroAtivo();
    }


    // ─────────────────────────────────────────────────────────
    // CLIENTES - CAMINHO ATUAL DO APP
    //
    // Hoje o Flutter está gravando:
    // clientes/{orgId}/{clienteId}/{arquivo}
    //
    // Mantemos essa regra para não quebrar o cadastro atual.
    // ─────────────────────────────────────────────────────────
    match /clientes/{orgId}/{clienteId}/{arquivo} {
      allow get: if ehMembroAtivo();
      allow list: if false;

      allow create, update: if ehMembroAtivo()
                            && isValidImage();

      allow delete: if ehMembroAtivo();
    }


    // ─────────────────────────────────────────────────────────
    // BLOQUEIO PADRÃO
    // ─────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}