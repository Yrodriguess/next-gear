rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function meuUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // ─────────────────────────────────────────────────────────
    // MEMBRO ATIVO DA EQUIPE
    //
    // Estar logado não basta: qualquer pessoa consegue criar uma conta
    // no Firebase Auth sem passar pelo app. Por isso, ler ou gravar
    // dados exige um cadastro em "usuarios" (que só um admin cria),
    // não bloqueado e com um papel da equipe.
    //
    // Cadastros antigos sem o campo "ativo" contam como ativos,
    // igual ao app.
    // ─────────────────────────────────────────────────────────
    function ehMembroAtivo() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && meuUsuario().get('ativo', true) == true
        && meuUsuario().get('role', '') in ['admin', 'financeiro', 'vendedor', 'estoque'];
    }

    function meuPapel() {
      return meuUsuario().role;
    }

    function meuOrgId() {
      return meuUsuario().orgId;
    }

    function temPapel(papel) {
      return ehMembroAtivo() && meuPapel() == papel;
    }

    function temAlgumPapel(papeis) {
      return ehMembroAtivo() && meuPapel() in papeis;
    }

    function ehAdmin() {
      return temPapel('admin');
    }

    function vendedorEditaSomenteDadosPermitidos() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'nome',
        'nomeFantasia',
        'cep',
        'logradouro',
        'numero',
        'complemento',
        'bairro',
        'cidade',
        'uf',
        'nomeResponsavel',
        'telefoneResponsavel',
        'emailResponsavel',
        'prazoAcertoDias',
        'localizacaoMapsUrl',
        'observacoesOperacionais',
        'frequenciaVisitaDiasPadrao',
        'periodoPreferencialVisita',
        'antecedenciaAvisoVisita',
        'fotoFachadaUrl',
        'updatedAt',
        'updatedBy'
      ]);
    }

    match /usuarios/{usuarioId} {
      allow read: if isSignedIn() && (request.auth.uid == usuarioId || ehAdmin());
      allow create, update: if ehAdmin();
      allow delete: if false;
    }

    match /clientes/{clienteId} {
      allow read: if ehMembroAtivo();
      allow create: if temAlgumPapel(['vendedor', 'admin'])
                    && request.resource.data.orgId == meuOrgId();
      allow update: if request.resource.data.orgId == resource.data.orgId
                    && resource.data.orgId == meuOrgId()
                    && (
                      temAlgumPapel(['financeiro', 'admin'])
                      || (
                        temPapel('vendedor')
                        && resource.data.vendedorResponsavelId == request.auth.uid
                        && vendedorEditaSomenteDadosPermitidos()
                      )
                    );
      allow delete: if false;
    }

    match /clienteCpfCnpjControle/{controleId} {
      allow read: if ehMembroAtivo();
      allow create: if temAlgumPapel(['vendedor', 'admin'])
                    && request.resource.data.orgId == meuOrgId();
      allow update: if temAlgumPapel(['vendedor', 'admin'])
                    && resource.data.orgId == meuOrgId()
                    && request.resource.data.orgId == resource.data.orgId
                    && request.resource.data.clienteId == resource.data.clienteId;
      allow delete: if temAlgumPapel(['vendedor', 'admin'])
                    && resource.data.orgId == meuOrgId();
    }

    match /auditLogs/{logId} {
      allow read: if ehMembroAtivo() && resource.data.orgId == meuOrgId();
      allow create: if temAlgumPapel(['admin', 'financeiro', 'vendedor'])
                    && request.resource.data.orgId == meuOrgId()
                    && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if false;
    }

    match /produtos/{produtoId} {
      allow read: if ehMembroAtivo();
      allow create, update: if temAlgumPapel(['admin', 'estoque']);
      allow delete: if false;
    }

    match /categoriasProduto/{categoriaId} {
      allow read: if ehMembroAtivo();
      allow create, update: if temAlgumPapel(['admin', 'estoque']);
      allow delete: if false;
    }

    match /skus/{skuId} {
      allow read: if ehMembroAtivo();
      allow create, update: if temAlgumPapel(['admin', 'estoque']);
      allow delete: if false;
    }

    match /skuPrecos/{precoId} {
      allow read: if ehMembroAtivo();
      allow create: if temAlgumPapel(['admin', 'estoque']);
      allow update, delete: if false;
    }

    match /skuBarcodes/{barcodeId} {
      allow read: if ehMembroAtivo();
      allow create: if temAlgumPapel(['admin', 'estoque']);
      allow update: if false;
      allow delete: if temAlgumPapel(['admin', 'estoque']);
    }

    match /expositorModelos/{modeloId} {
      allow read: if ehMembroAtivo();
      allow create, update: if temAlgumPapel(['admin', 'estoque']);
      allow delete: if false;
    }

    match /expositoresFisicos/{expositorId} {
      allow read: if ehMembroAtivo();
      allow create, update: if temAlgumPapel(['admin', 'estoque', 'vendedor', 'financeiro']);
      allow delete: if false;
    }

    match /expositorMovimentacoes/{movId} {
      allow read: if ehMembroAtivo();
      allow create: if temAlgumPapel(['admin', 'estoque', 'vendedor', 'financeiro']);
      allow update, delete: if false;
    }

    match /estoqueMovimentacoes/{movId} {
      allow read: if ehMembroAtivo();
      allow create: if temAlgumPapel(['admin', 'estoque', 'vendedor'])
                    && request.resource.data.orgId == meuOrgId();
      allow update, delete: if false;
    }

    match /estoqueSaldos/{saldoId} {
      allow read: if ehMembroAtivo();
      allow create, update: if temAlgumPapel(['admin', 'estoque', 'vendedor'])
                             && request.resource.data.orgId == meuOrgId();
      allow delete: if false;
    }

    match /consignments/{consignmentId} {
      allow read: if ehMembroAtivo();
      allow create: if temAlgumPapel(['admin', 'vendedor']);
      allow update: if temAlgumPapel(['admin', 'vendedor'])
                    && resource.data.status == 'ativa';
      allow delete: if false;
    }

    match /visitas/{visitaId} {
      allow read: if ehMembroAtivo();
      allow create, update: if temAlgumPapel(['admin', 'vendedor']);
      allow delete: if false;
    }

    match /contasAReceber/{recebivelId} {
      allow read: if ehMembroAtivo();
      allow create, update: if temAlgumPapel(['admin', 'financeiro', 'vendedor']);
      allow delete: if false;
    }

    match /payments/{pagamentoId} {
      allow read: if ehMembroAtivo();
      allow create: if temAlgumPapel(['admin', 'financeiro', 'vendedor']);
      allow update: if temAlgumPapel(['admin', 'financeiro', 'vendedor']);
      allow delete: if false;
    }

    match /acertosCaixa/{acertoId} {
      allow read: if ehMembroAtivo();
      allow create: if temAlgumPapel(['admin', 'financeiro', 'vendedor']);
      allow update: if temAlgumPapel(['admin', 'financeiro']);
      allow delete: if false;
    }

    match /documentosGerados/{documentoId} {
      allow read: if ehMembroAtivo();

      // Criação normal:
      // - "gerando" = reserva persistente da Etapa 3;
      // - "ativo" = compatibilidade com documentos legados.
      allow create: if temAlgumPapel(['admin', 'vendedor'])
                    && request.resource.data.orgId == meuOrgId()
                    && request.resource.data.status in ['gerando', 'ativo']
                    && request.resource.data.keys().hasAll([
                      'orgId',
                      'numero',
                      'tipo',
                      'clienteId',
                      'visitaId',
                      'status',
                      'assinatura'
                    ]);

      // A Etapa 3 só permite atualizar uma preparação ainda não concluída.
      // Documento ativo ou cancelado continua imutável.
      allow update: if temAlgumPapel(['admin', 'vendedor'])
                    && resource.data.orgId == meuOrgId()
                    && request.resource.data.orgId == resource.data.orgId
                    && request.resource.data.numero == resource.data.numero
                    && request.resource.data.tipo == resource.data.tipo
                    && request.resource.data.clienteId == resource.data.clienteId
                    && request.resource.data.visitaId == resource.data.visitaId
                    && resource.data.status in ['gerando', 'erro']
                    && request.resource.data.status in ['gerando', 'erro', 'ativo']
                    && request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly([
                          'urlStorage',
                          'hash',
                          'status',
                          'assinatura',
                          'assinaturaPngTemporaria',
                          'erroGeracao',
                          'tentativasGeracao',
                          'atualizadoEm'
                        ]);

      allow delete: if false;
    }

    // Contadores que numeram consignações, visitas, recebíveis e
    // documentos. O app só cria e incrementa; nunca apaga.
    match /counters/{counterId} {
      allow read, create, update: if ehMembroAtivo();
      allow delete: if false;
    }
  }
}
